---
import "@/styles/global.css";
import Seo from "@/components/Seo.astro";

const {
  title = "Inzend — AI & Automation",
  description = "AI & automation systems that turn complexity into leverage.",
  image = "/og.jpg"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="view-transitions h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {image} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload Satoshi var font if available -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/satoshi/Satoshi-Variable.woff2" crossorigin>
  </head>
  <body class="min-h-screen bg-base text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
