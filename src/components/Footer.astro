---
const year = new Date().getFullYear();

const navPrimary = [
  { href: "/services", label: "Services" },
  { href: "/case-studies", label: "Case Studies" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const navLegal = [
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" }
];

// Ruta del logo (en /public)
const LOGO_SRC = "/inzend-logo.png"; // o "/images/inzend-logo.png"
---

<footer class="relative border-t border-line bg-base text-fg">
  <div class="container-base py-14 md:py-18">
    <!-- Top: message + email ONLY (no botones) -->
    <div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight">
          Ready to move faster with AI & automation?
        </h2>
        <p class="mt-3 text-muted max-w-prose">
          I design, build, and measure systems that remove friction and scale your operation.
        </p>
      </div>
      <div class="text-right">
        <p class="text-xs text-subtle">Email</p>
        <a href="mailto:hello@inzend.com" class="text-accent hover:underline text-sm">hello@inzend.com</a>
        <p class="text-subtle text-xs mt-1">Mon–Fri · 9–5 (CT)</p>
      </div>
    </div>

    <div class="my-10 border-t border-line/70" role="presentation"></div>

    <!-- Middle: 3 columns perfectly aligned -->
    <div class="grid gap-8 md:grid-cols-3">
      <!-- Brand -->
      <div class="space-y-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-full focus-visible:outline-2 focus-visible:outline-[hsl(var(--ring))]" aria-label="Inzend — Home">
          <img
            src={LOGO_SRC}
            alt="Inzend logo"
            width="128" height="28"
            class="h-7 w-auto block"
            decoding="async"
            loading="lazy"
          />
        </a>
        <p class="text-subtle text-sm max-w-xs">
          AI & automation systems for business: architecture, integration, and measurable delivery.
        </p>
      </div>

      <!-- Site navigation -->
      <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
        {navPrimary.map(i => (
          <a href={i.href} class="text-muted hover:text-fg rounded-lg px-1 py-1">{i.label}</a>
        ))}
      </nav>

      <!-- Social -->
      <div class="space-y-3">
        <p class="text-sm text-subtle">Follow</p>
        <div class="flex items-center gap-3 text-muted">
          <a href="https://github.com/inzend" aria-label="GitHub" class="rounded-full p-2 hover:bg-surface-2/70 hover:text-fg">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.68c-2.78.61-3.37-1.18-3.37-1.18-.46-1.16-1.12-1.47-1.12-1.47-.92-.63.07-.62.07-.62 1.02.07 1.56 1.05 1.56 1.05.9 1.55 2.36 1.1 2.94.84.09-.65.35-1.1.63-1.36-2.22-.26-4.55-1.11-4.55-4.95 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.3.1-2.7 0 0 .85-.27 2.8 1.03a9.62 9.62 0 0 1 5.1 0c1.95-1.3 2.8-1.03 2.8-1.03.55 1.4.2 2.44.1 2.7.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.86v2.76c0 .26.18.57.69.48A10 10 0 0 0 12 2Z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/inzend" aria-label="LinkedIn" class="rounded-full p-2 hover:bg-surface-2/70 hover:text-fg">
            <!-- LinkedIn official 'in' mark (correct path) -->
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M4.983 3.5C4.983 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.483 1.12 2.483 2.5zM.2 8.339h4.6V24H.2V8.339zM8.339 8.339h4.414v2.129h.062c.614-1.163 2.115-2.39 4.352-2.39C21.89 8.078 24 10.02 24 13.73V24h-4.6v-8.93c0-2.131-.762-3.586-2.666-3.586-1.454 0-2.321.978-2.703 1.92-.139.34-.174.813-.174 1.29V24H9.257s.061-14.942 0-16.461h4.414v2.336c.585-.903 1.63-2.19 3.97-2.19 2.897 0 5.359 1.89 5.359 5.956V24H8.339V8.339z"/>
            </svg>
          </a>
          <a href="https://x.com/inzend" aria-label="X (Twitter)" class="rounded-full p-2 hover:bg-surface-2/70 hover:text-fg">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 4h4.7l3.7 5.3L16.7 4H20l-6 7.3L20 20h-4.7l-3.9-5.6L7.3 20H4l6.3-7.7L4 4Z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-subtle">
      <p>© {year} Inzend. All rights reserved.</p>
      <ul class="flex items-center gap-4">
        {navLegal.map(i => (<li><a href={i.href} class="hover:text-fg">{i.label}</a></li>))}
      </ul>
    </div>
  </div>
</footer>
