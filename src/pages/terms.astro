---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const title = "Terms of Service — Inzend";
const description = "Terms governing the use of this website and services.";
const updated = "2025-11-04";
---

<Layout {title} {description}>
  <Header isHome={false} />

  <section class="bg-base text-fg">
    <div class="container-base pt-28 md:pt-36 pb-16 md:pb-24">
      <header class="max-w-3xl">
        <span class="eyebrow fx-fade-in" data-reveal>Legal</span>
        <h1 class="mt-3 text-4xl md:text-5xl font-bold tracking-tight fx-fade-in" data-reveal data-delay="80">
          Terms of Service
        </h1>
        <p class="text-sm text-subtle mt-2 fx-fade-in" data-reveal data-delay="120">Last updated: {updated}</p>
        <p class="lede mt-4 fx-fade-up" data-reveal data-delay="160">
          Please read these terms carefully. By using this site or engaging services, you agree to them.
        </p>
      </header>

      <article class="prose-invert max-w-3xl mt-8 space-y-6">
        <section class="card p-6 fx-fade-up" data-reveal>
          <h2 class="text-xl font-semibold">Scope</h2>
          <p class="text-sm text-muted mt-2">
            These terms apply to the Inzend website and any services offered. Specific project terms will be outlined
            in a separate proposal or agreement.
          </p>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="80">
          <h2 class="text-xl font-semibold">Use of the site</h2>
          <p class="text-sm text-muted mt-2">
            You may browse and share public content for lawful purposes. Do not attempt to disrupt, reverse engineer,
            or misuse the site or its infrastructure.
          </p>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="120">
          <h2 class="text-xl font-semibold">Engagements & deliverables</h2>
          <ul class="mt-2 space-y-1 text-sm text-muted">
            <li>• Project scope, timeline, and pricing are defined in writing.</li>
            <li>• Work begins upon written acceptance and initial payment if required.</li>
            <li>• Intellectual property terms are outlined in the project agreement.</li>
          </ul>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="160">
          <h2 class="text-xl font-semibold">Confidentiality</h2>
          <p class="text-sm text-muted mt-2">
            Both parties agree to protect confidential information shared for the purpose of evaluating or performing work.
          </p>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="200">
          <h2 class="text-xl font-semibold">Disclaimers</h2>
          <p class="text-sm text-muted mt-2">
            The site is provided “as is.” While we aim for accuracy and availability, we do not warrant uninterrupted or error-free operation.
          </p>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="240">
          <h2 class="text-xl font-semibold">Limitation of liability</h2>
          <p class="text-sm text-muted mt-2">
            To the fullest extent permitted by law, Inzend is not liable for indirect, incidental, or consequential damages.
          </p>
        </section>

        <section class="card p-6 fx-fade-up" data-reveal data-delay="280">
          <h2 class="text-xl font-semibold">Contact</h2>
          <p class="text-sm text-muted mt-2">
            For questions about these terms, email <a class="text-accent hover:underline" href="mailto:hello@inzend.com">hello@inzend.com</a>.
          </p>
        </section>
      </article>

      <!-- Soft close: no big primary button -->
      <p class="mt-10 text-sm text-subtle">
        Looking for work details instead? Visit the <a href="/services" class="text-accent hover:underline">Services</a> page.
      </p>
    </div>

    <script is:inline>
      import("/src/scripts/motion.ts").then((m) => {
        document.documentElement.classList.add("ready-anim");
        m.mountReveal();
      }).catch(() => {
        document.documentElement.classList.remove("ready-anim");
      });
    </script>
  </section>

  <Footer />
</Layout>
